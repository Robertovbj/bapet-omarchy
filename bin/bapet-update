#!/usr/bin/env bash
# Atualiza o BApet: git pull no clone limpo + dependências do requirements.txt.
set -euo pipefail
BAPET_HOME="${BAPET_HOME:-$HOME/.local/share/bapet}"
cd "$BAPET_HOME/src"
before=$(git rev-parse HEAD)
git pull --ff-only
VIRTUAL_ENV="$BAPET_HOME/venv" uv pip install -q -r requirements.txt
after=$(git rev-parse HEAD)
if [ "$before" = "$after" ]; then
  echo "BApet já está atualizado ($(git describe --tags --always))."
else
  git log --oneline "$before..$after"
  echo "Atualizado. Reinicie o app (Quit no menu da barra e abra de novo)."
fi
