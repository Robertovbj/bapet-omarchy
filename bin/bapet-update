#!/usr/bin/env bash
# Updates BApet only: pulls the clean clone and installs its requirements.txt.
set -euo pipefail
BAPET_HOME="${BAPET_HOME:-$HOME/.local/share/bapet}"
cd "$BAPET_HOME/src"
before=$(git rev-parse HEAD)
git pull --ff-only
VIRTUAL_ENV="$BAPET_HOME/venv" uv pip install -q -r requirements.txt
after=$(git rev-parse HEAD)
if [ "$before" = "$after" ]; then
  echo "BApet is up to date ($(git describe --tags --always))."
else
  git log --oneline "$before..$after"
  echo "Updated. Restart the app (Quit from the bar menu, then open it again)."
fi
