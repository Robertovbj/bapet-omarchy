#!/usr/bin/env bash
# Runs BApet from the unmodified clone in ~/.local/share/bapet/src, through the
# launcher in ~/.local/share/bapet/overrides, which applies the local tweaks in memory.
BAPET_HOME="${BAPET_HOME:-$HOME/.local/share/bapet}"

# The app needs XWayland to position its own windows. It switches by itself only
# when QT_QPA_PLATFORM is unset, and Omarchy exports "wayland;xcb", so force it here.
export QT_QPA_PLATFORM=xcb
export PYTHONPATH="$BAPET_HOME/overrides:$BAPET_HOME/src${PYTHONPATH:+:$PYTHONPATH}"

cd "$BAPET_HOME/src" || exit 1
exec "$BAPET_HOME/venv/bin/python" -m bapet_omarchy "$@"
