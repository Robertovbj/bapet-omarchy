#!/usr/bin/env bash
# Switches BApet's pets between two modes:
#   ghost        clicks go through the whole pet window (default)
#   interactive  you can drag a pet, click it and open its menu
# Usage: bapet-ghost [toggle|on|off|status]
set -euo pipefail
STATE="${XDG_RUNTIME_DIR:-/tmp}/bapet-mode"
mode=$(cat "$STATE" 2>/dev/null || echo ghost)

case "${1:-toggle}" in
  status) echo "$mode"; exit 0 ;;
  on) want=ghost ;;
  off) want=interactive ;;
  toggle) [ "$mode" = ghost ] && want=interactive || want=ghost ;;
  *) echo "usage: bapet-ghost [toggle|on|off|status]" >&2; exit 2 ;;
esac

[ "$want" = interactive ] && sign="+" || sign="-"
hyprctl clients -j | jq -r '.[] | select(.class == "BlueArchiveDesktopPet" and (.title | startswith("Desktop Pet"))) | .address' |
  while read -r addr; do
    hyprctl dispatch "hl.dsp.window.tag({ tag = \"${sign}bapet-touch\", window = \"address:$addr\" })" >/dev/null
  done
echo "$want" > "$STATE"

if [ "${BAPET_QUIET:-0}" != 1 ]; then
  [ "$want" = ghost ] && msg="Clicks now go through your pets" || msg="You can drag and click your pets"
  notify-send -a "Desktop Pets" -t 2000 "$msg" || true
fi
echo "$want"
